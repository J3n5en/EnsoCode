# 复制为 .env.harbor（已 gitignore）。值不要提交。
HARBOR_API_KEY=
# 模型 id 本身。带斜杠也原样写，脚本会按协议加上 openai/ 或 anthropic/ 前缀。
HARBOR_MODEL=
# 模型端点。写成 127.0.0.1 或 localhost 时，脚本会改成 host.docker.internal，容器才访问得到宿主机。
HARBOR_BASE_URL=
# openai-responses、openai-completions 或 anthropic-messages。
HARBOR_API_FORMAT=openai-responses
# 可选。安装 @vscode/ripgrep 时避开 GitHub 匿名额度。
# GITHUB_TOKEN=
# HARBOR_DATASET=terminal-bench@2.0
# HARBOR_LIMIT=1
