{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@enso/pair": ["../pair/src/index.ts"],
      "@/i18n": ["./src/stubs/i18n.tsx"],
      "@/stores/settings": ["./src/stubs/settings-store.ts"],
      "@/stores/sessions": ["./src/stubs/sessions-store.ts"],
      "@/*": ["../../src/renderer/*"],
      "@shared/*": ["../../src/shared/*"]
    }
  },
  "include": ["src/**/*"]
}
