    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "better-sqlite3",
      "classic-level",
      "electron",
      "electron-winstaller",
